SECRET_KEY=change-me-in-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Separate encryption key for MFA TOTP secrets (never reuse SECRET_KEY).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=generate-and-set-this

# Local Postgres:
DB_NAME=akevra_sprint0
DB_USER=fakhir
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Render + Neon: paste the Neon URI here instead of DB_* above
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

CORS_ORIGINS=

AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_SECONDS=900
AUTH_SESSION_IDLE_SECONDS=900
AUTH_SESSION_ABSOLUTE_SECONDS=28800
AUTH_MFA_ISSUER=AKEVRA

# Invitations (activation links point at the frontend)
INVITATION_TTL_HOURS=72
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=10
# Email (invitations + password reset codes). Without EMAIL_BACKEND nothing is sent.
# Option A — Brevo HTTPS API (works on Railway, which blocks SMTP on smaller plans):
# EMAIL_BACKEND=apps.core.email.BrevoEmailBackend
# BREVO_API_KEY=
# DEFAULT_FROM_EMAIL=AKEVRA <verified-sender@example.com>
# Option B — SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=AKEVRA <no-reply@akevra.app>
